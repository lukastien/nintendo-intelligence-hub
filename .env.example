# Local defaults. Copy to .env. These values match docker-compose.yml
# and are for the local warehouse only.

NIH_WAREHOUSE_TARGET=postgres
NIH_POSTGRES_HOST=localhost
NIH_POSTGRES_PORT=54329
NIH_POSTGRES_DB=nintendo_intel
NIH_POSTGRES_USER=nih
NIH_POSTGRES_PASSWORD=nih_local_only
# Optional. Leave unset for the local Docker database.
# NIH_POSTGRES_SSLMODE=require

# Optional later phase. Leave the project empty to stay on local PostgreSQL.
# NIH_WAREHOUSE_TARGET=bigquery
# NIH_BIGQUERY_PROJECT=
# NIH_BIGQUERY_DATASET=nintendo_intel
# NIH_BIGQUERY_LOCATION=US

# Optional monitoring notifications. Disabled by default. No real
# notification is sent unless NIH_NOTIFICATIONS_ENABLED=true and a
# destination below is configured. Values are never logged.
# NIH_NOTIFICATIONS_ENABLED=false
# NIH_NOTIFICATION_MIN_SEVERITY=warning
# NIH_SLACK_WEBHOOK_URL=
# NIH_SMTP_HOST=
# NIH_SMTP_PORT=587
# NIH_SMTP_USER=
# NIH_SMTP_PASSWORD=
# NIH_NOTIFICATION_EMAIL_FROM=
# NIH_NOTIFICATION_EMAIL_TO=

# Optional monitoring thresholds (defaults are in monitoring/rules.py).
# NIH_MONITOR_YOY_CHANGE=0.50
# NIH_MONITOR_ROBUST_Z=3.5
# NIH_MONITOR_MARGIN_CHANGE_POINTS=0.05

# Optional IGDB metadata. Leave unset to report IGDB unavailable.
# These are Twitch application credentials, not Nintendo figures.
# NIH_IGDB_CLIENT_ID=
# NIH_IGDB_CLIENT_SECRET=
